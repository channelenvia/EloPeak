{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "supabase/functions/*/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "shared/**/*.ts",
    "supabase/functions/**/*.ts"
  ],
  "ignore": [
    "src/lib/database.types.ts",
    "supabase/functions/_shared/*.test.ts"
  ],
  "ignoreBinaries": [
    "supabase"
  ],
  "ignoreExportsUsedInFile": true
}
