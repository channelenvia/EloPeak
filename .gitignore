# Dependencies
scripts/
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist_new/
dist_v2/
build/

# Booster Launcher desktop app — only its generated output is build output;
# src/, scripts/, package.json etc. are real source and stay tracked. (The
# bare `launcher` entry this replaced accidentally excluded the whole app,
# including its source, from git — see launcher/scripts/ negation below for
# the fallout from the repo-wide `scripts/` rule above.)
launcher/node_modules/
launcher/dist/
launcher/release/
launcher/build/
launcher/config.json
launcher/*.log
!launcher/scripts/
Booster Launcher/
Booster Launcher.exe

# Environment - NEVER commit secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Logs and coverage
*.log
coverage/

# Supabase
supabase/.branches
supabase/.temp
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.local
!supabase/functions/.env.example

# Historical migrations are versioned because the active migrations depend on
# objects introduced before the current baseline. Keeping the archive in Git
# makes fresh database reconstruction and schema-regression tests reproducible.

# Deploy tooling
.vercel/

# AI tooling - not part of the codebase
.planning/
.superpowers/
docs/
.claude/
.agents/
graphify-out/
.playwright/
.playwright-mcp

# Keys and certs — never commit
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
*.mobileprovision
